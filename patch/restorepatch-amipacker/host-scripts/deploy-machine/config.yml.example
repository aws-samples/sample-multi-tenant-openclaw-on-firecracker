# 部署配置 - 示例
# 复制为 config.yml 后按需修改

# ========== 部署机前置条件 ==========
# 必须有可用 docker:API Lambda 资产走容器打包;docker 不可用时 cdk synth 会报
# Failed to bundle asset ... docker exited with status 1。
# PATH 里的 python3 必须 >= 3.12:cdk.json 直接执行 python3 deploy/app.py。
# AL2023 默认 python3 是 3.9;即使另装了 python3.12,也要把 3.12 venv 放到 PATH 最前。

# ========== ⚠️ 代码不读的键(从旧配置迁移时逐项删除)==========
# | 死键 | 正确做法 |
# | --- | --- |
# | redis.instance_type | 改用 redis.node_type;代码只读 node_type |
# | edge.data_volume_gb | edge 段没有磁盘键,使用 AMI 默认根盘 |
# | alb.certificate_arn | 控制台 HTTPS 用 console_auth.bff_certificate_arn;数据面 TLS 开 CloudFront |
# | console_auth.bff_in_vpc | BFF 是否入 VPC 由 imported 模式自动派生 |
# | asg.scale_in_enabled | 无替代配置键;当前配置层没有自动缩容开关 |
# | scaler.idle_reclaim_enabled | 同为死键,不要拿它替代 asg.scale_in_enabled |
# | edge.migration_drain_seconds | 当前代码不读,不要写入配置 |
# 自动缩容当前在 deploy/lambda/scaler/handler.py 以 IDLE_RECLAIM_ENABLED=False
# 硬禁且不读 env;上述两个缩容键都不会生效。

# ========== 宿主机 (EC2) ==========
host:
  # 切换 arch 后必须用 ./build-rootfs.sh --arch <arch> 重建 rootfs.
  arch: arm64
  # 场景);空=按 network.mode 自动选(self_managed/imported→私有,default_vpc→公有)。
  subnet_ids: []
  ssh_key_name: ""        # 开发期SSH keypair名(配了metal绑key,堡垒机可SSH);生产留空
  ssh_ingress_sg: ""      # 堡垒机SG id(配了host SG放它入站22;禁0.0.0.0/0);生产留空                      # x86_64 | arm64。生产基线=arm64(Graviton metal 原生 KVM)
  instance_type: r8g.metal-24xl    # 生产=r8g.metal-24xl(96vCPU/768GB,380租户/台)。开发可用 m8g.xlarge
  # 可选混合机型池(ASG MixedInstancesPolicy,提升可用性/Spot 韧性)。Phase 7:
  # 池内成员可以是不同 SIZE(如 r8g.metal-48xl + r8g.metal-24xl)——init-host.sh
  # 启动时按 nproc + /proc/meminfo 自报每台真实容量注册 DDB,小机型注册自己的小
  # 容量不会被超卖。约束:所有成员须与 host.arch 同架构(AMI 是按架构的,x86 与
  # arm64 不能混)。留空=只用上面的单一 instance_type。
  # (MixedInstancesPolicy.InstancesDistribution.OnDemandAllocationStrategy=prioritized
  # + 每个 Override 带显式 Priority),租户落哪台则由调度侧亲和排序决定
  # (scheduling.family_order),两者必须同序。改本列表顺序即改扩容优先级。
  # 注:列表首项同时是 LaunchTemplate 主类型与 scaler 容量估算基准,应填最高优先级机型。
  instance_types:
    - r8g.metal-24xl               # 96 vCPU / 768 GiB · 8.0 GB/vCPU
    - r7g.metal                    # 64 vCPU / 512 GiB · 8.0 GB/vCPU
    - m8g.metal-24xl               # 96 vCPU / 384 GiB · 4.0 GB/vCPU
    - m7g.metal                    # 64 vCPU / 256 GiB · 4.0 GB/vCPU
  root_volume_gb: 20
  # (OS 盘足够,零额外成本)。需要时显式抬高(取消注释):
  # root_volume_iops: 3000         # gp3 3000–16000
  # root_volume_throughput: 125    # gp3 125–1000 MiB/s
  data_volume_gb: 900              # 380 VM/台的磁盘硬前提。真机对账(#37,2026-07-04 us-east-1 压 377 VM):/data 实占随负载走——轻载 377 VM 仅占 28G(sparse 单 VM ~84–187M),重载单 VM 实占可达 1.3G,380×1.3G≈494G。600G 够 380 稀疏稳态但重载几乎无冗余;提到 900G 给重载 + 未来密度(#51)余量,仍远低于 380×8G(vm.data_disk_mb 声明上限,靠 sparse 不全占)。改大后 host 重建即带大盘,不依赖运行态扩盘。
  # 默认 8000 IOPS / 500 MiB/s,来自 us-west-2 真机 fio 扫档 + apse1 14 租户实测 + 成本边际分析:
  #   · IOPS 8000:apse1 写 IOPS 峰值 276(14 租户)线性外推 380 VM ≈7500,8000 覆盖突发;
  #     饱和下读 p99 延迟 36ms(3000 档 100ms)。gp3 硬配额、买多少给多少,3 轮方差 0%。
  #   · 吞吐 500:边际效益拐点。125→500 每 $1 省 1.7min 全量搬运,过 500 后每 $1 仅省
  #     0.6min(→750)/0.3min(→1000)。500=4× 基线,覆盖真实并发 backup/restore/suspend。
  # 成本 ≈ +$40/卷·月(IOPS $0.005/个·月 + 吞吐 $0.04/MiB·月)。要更快备份可调高吞吐(≤1000)。
  data_volume_iops: 8000           # gp3 3000–16000(本项目上限锁 8000);每 +1000 = +$5/卷·月
  data_volume_throughput: 500      # gp3 125–1000 MiB/s;每 +125 = +$5/卷·月;约束 iops ≥ throughput/0.25
  keep_data_volume:  true          # 实例删除后是否保留EBS卷
  reserved_vcpu: 1
  reserved_mem_mb: 2048
  # IO/等待型,4 个 1c 租户同时跑满的概率低、时间片可复用;内存不能这么做(占住
  # 就不还,balloon 回收是 best-effort)。
  # 1:4 不是拍的 —— 理想比 = 物理供给(GB/vCPU) ÷ 租户需求(GB/vCPU):
  #   R 系 8.0/2.0 = 4.0 → 1:4 恰好匹配(r8g 95×4=380 槽,正是 380/台 目标的来源)
  #   M 系 4.0/2.0 = 2.0 → 统一 1:4 时 M 系多出的 CPU 槽内存跟不上,会搁浅
  #                        (m8g 189 vcpu / m7g 125 vcpu),这是【已接受的代价】,
  #                        由 openclaw_host_stranded_vcpu 指标观测,阈值需相应放宽。
  # 从 6.0 降到 4.0 是【收紧】放行条件:6.0 的 570 槽是虚容量(内存只够 383),
  # 真实上限一直由内存决定。r8g 仍满足 380/台,不减容。
  cpu_overcommit_ratio: 4.0
  # 150%(374 个 1c2G 塞进 384GB),物理内存打满到 0G。
  # 物理层防护改由 scheduling.mem_safety_floor_ratio 用 host 自报的实测
  # MemAvailable 兜底(两维职责分离:账本防超卖,实测防 OOM),不再靠记账超卖赌 balloon。
  mem_overcommit_ratio: 1.0
  #
  # 当前【留空】:四机型统一 cpu=4.0 / mem=1.0 就能达到按标称规格定义的容量目标,
  # 不需要任何补偿系数。原因是 host 现在按【标称】规格注册容量(init-host.sh 查
  # synth 时烤进的 {{NOMINAL_SPECS}} 表,表由 ha_edge.py 的 _sizes × _mem_ratio 生成):
  #     r8g.metal-24xl  96vcpu/768GiB -> min(96×4, 768÷2) = 384
  #     r7g.metal       64vcpu/512GiB -> min(64×4, 512÷2) = 256
  #     m8g.metal-24xl  96vcpu/384GiB -> min(96×4, 384÷2) = 192  (内存先耗尽)
  #     m7g.metal       64vcpu/256GiB -> min(64×4, 256÷2) = 128  (内存先耗尽)
  #
  # 早先曾给每个 family 配补偿系数(mem 1.022/1.023/1.025/1.028),因为那时 host 按
  # nproc+/proc/meminfo 的【实测】值注册 —— 实测比标称小 1.8-1.9%(固件/硬件保留),
  # 再扣 reserved_* 后只能到 375/250/187/124。但那是四个必须手算的魔数:每上一款
  # 新机型都要重算,且极易算错(2026-08-11 就因用推算容量而非实测,让 r7g/m7g 少了
  # 5 个和 3 个)。改为按标称注册后系数全部消失。
  #
  # 机制保留:若将来某类机型要单独调超卖比(如 M 系降 cpu 到 2.0 消除 CPU 搁浅),
  # 在这里加一条即可。形如:
  #   overcommit_by_family: {m8g: {cpu: 2.0, mem: 1.0}, m7g: {cpu: 2.0, mem: 1.0}}
  overcommit_by_family: {}
  # 为什么要:开机时装组件不可靠——awscli 拿错架构 zip、aarch64 少 vmlinux 后缀、
  # Firecracker tarball 404,这三个都真实发生过,每次都让 host 超时丢掉 600s
  # lifecycle hook,ASG 进入 ABANDON-重建循环。烤进镜像后 golden 启动路径零外网下载。
  #
  # 两个开关分开是有意的:烤镜像和用镜像是两个决定。build_pipeline=true 只是让
  # OpenClawHostImage stack 建出 Image Builder 流水线(还要手动/API 触发一次烤制);
  # use=true 才把 host LaunchTemplate 指到烤出来的 AMI。先烤后用,顺序不能反——
  # use=true 但参数里还没有 AMI id,ASG 每次 launch 都会失败。
  golden_ami:
    build_pipeline: false           # true=部署 Image Builder 流水线(component/recipe/distribution)
    use: false                      # true=host LT 用 resolve:ssm 读 golden AMI;false=用 Canonical 公共 AMI
    recipe_version: "1.0.0"         # 改这里=新版本 component+recipe(必须 x.y.z;同版本号重复部署会被 Image Builder 拒绝)
    ssm_parameter: ""               # 留空=用默认 /imagebuilder/openclaw/host-ami<region后缀>;跨 stack 复用别人烤的镜像时才填
    build_instance_type: ""         # 留空=按 arch 选 c7g.large / c7i.large。烤制机是一次性的,不用 metal

# ========== Balloon 内存回收 (配合 mem_overcommit) ==========
balloon:
  enabled: true                    # 启用 balloon 设备实现真正的内存超配
  max_inflate_ratio: 0.4           # 最多回收 VM 声明内存的 40%
  min_guest_available_mb: 512      # guest 至少保留 512MB 可用内存
  stats_polling_interval_s: 5      # balloon 统计采集间隔
  deflate_on_oom: true             # guest OOM 时自动归还内存
  free_page_reporting: true        # guest 主动报告空闲页

# ========== microVM ==========
# 当前仅 firecracker 完整可用; cloud_hypervisor 与 qemu 是预留插槽,
# 启用会抛 RuntimeNotImplementedError 直到对应驱动实现.
runtime: firecracker  # firecracker | cloud_hypervisor | qemu

vm:
  default_vcpu: 2
  default_mem_mb: 4096
  rootfs_overlay_mb: 8192          # 每个 VM 可写层上限 (sparse, 不预占空间)
  data_disk_mb: 8192               # 每个 VM 数据盘 /home/agent 上限 (sparse)
  gateway_port_base: 18789
  subnet_prefix: "172.16"
  # recover / 多批 SSM fan-out 一轮 fire 几百个 launch-vm,瞬时 CPU/IO 二次洪峰压垮 host。超出的排队
  # 等(限速不丢租户)。默认 30(真机验证值);单一来源,同时注入 host(OC_HOST_LAUNCH_SLOTS)与
  # Lambda(DISPATCH_HOST_LAUNCH_CONCURRENCY,SSM 超时公式分母)。非正数回落 30。
  host_launch_slots: 30

# ========== Per-tenant 资源配额 ==========
# 每租户 vCPU / 内存 / 数据盘上限,注入 API Lambda env(lambdas.py:263-267 读)。
# 默认全关(enabled: false + 上限 0),建租户不做配额校验(向后兼容)。
quotas:
  enabled: false            # 启用 per-tenant 资源配额(注入 QUOTAS_ENABLED)
  max_vcpu_per_tenant: 0    # 0=不限
  max_mem_mb_per_tenant: 0
  max_data_disk_mb: 0

# 4 机型混池的租户放置策略。机型池本身在 host.instance_types(那里决定 ASG 启动
# 哪台机器),这里决定【租户落哪台】。两处顺序必须一致,否则池按一个序扩容、
# 按另一个序填租户。
scheduling:
  # 四级机型亲和排序开关。false = 逐字节回落既有的 free_vcpu / min(两维ratio) 排序
  # (回退开关:关掉即恢复现状,不需回滚代码)。
  affinity_enabled: true
  # 机型优先顺序(family 前缀)。业务要求:R 系优先填满、M 系少接留安全余量。
  # 排序键是两级 —— 主键 mem_per_vcpu 分档(R 系 8.0 GB/vCPU vs M 系 4.0),次键本表
  # 定同档内代际。为什么需要次键:4 机型的 GB/vCPU 只有 2 个不同值(r8g=r7g=8.0、
  # m8g=m7g=4.0),纯靠资源比例分不出 r8g→r7g 与 m8g→m7g 的先后,那是代际决定的。
  # 新机型上线只改本表,不改代码。
  family_order: ["r8g", "r7g", "m8g", "m7g"]
  # 物理内存安全水位:host 自报的实测 MemAvailable 低于 mem_total × 此比例时不接新
  # 租户。0 = 关闭物理门(只留账本闸)。
  # 为什么需要它:账本 used_mem_mb 只证明"声明内存没超卖",但租户真实占用可能超出
  # 声明(balloon 回收是 best-effort)。与既有磁盘软门同款三段逻辑:门关/无信号/
  # 信号陈旧一律 fail-open,只在【新鲜确认不足】时阻断,绝不用过期读数误摘健康 host。
  mem_safety_floor_ratio: 0.10
  # 物理内存信号新鲜度 TTL(秒)。超期即 fail-open —— host-agent 挂了是正交问题,
  # 交 health_check + ASG 兜底,调度门不越权用过期读数永久封锁 host。0 = 不校验新鲜度。
  mem_check_ttl_sec: 300

# ========== S3 ==========
s3:
  rootfs_prefix: "deployment/rootfs"
  backup_prefix: "backups"
  backup_retention_days: 7
  # PRD 2.6 每用户错峰备份:backup_cron 是"扫描节拍"非统一时间。每次只备到期
  # (距上次 > backup_interval_hours)的一批、最多 backup_batch_limit 个 → 错峰+削并发。
  backup_cron: "rate(30 minutes)"
  backup_interval_hours: 24   # 每租户至少每 24h 备一次
  backup_batch_limit: 20      # 单次触发最多备 20 个(削并发,避免同刻全量)
  # 备份桶名后缀,默认空。仅当上一次部署留下 WORM(Object Lock COMPLIANCE)备份桶、
  # 在保留期内连 root 都删不掉、又要立刻用同名重建时,填一个短后缀(如 -v2)让
  # 新桶避开撞名;旧锁定桶等 backup_retention_days 过期后再单独清。
  # backup_bucket_suffix: ""

# ========== Auto Scaling ==========
asg:
  # 首次部署必须先设 0:镜像烤制是非阻塞独立栈;若 min>=1,host 会抢在镜像就绪前
  # 启动并因拉不到镜像触发 lifecycle hook ABANDON,ASG 随后反复换机。
  min_capacity: 0
  max_capacity: 8
  # init-host 必须在此超时内完成(注册 DDB 后 CONTINUE),否则 ABANDON→ASG 替换。
  # r8g.metal-24xl 物理机:Nitro 硬件初始化慢 + 下载 842MB 黄金镜像(rootfs+data)+
  # 解压挂盘 + 注册,600s 偏紧会反复 Heartbeat Timeout 替换。
  # imported VPC + metal 场景真机 1200s 也不够,默认给 3600s(1h)留足余量;
  # preflight-region.sh 的门是 >=2700,低于它先红灯(#488)。
  lifecycle_hook_timeout: 3600
  use_spot: false

# Private S3 object only. Empty s3_uri disables the hook with zero behavior
# change. When enabled, pin the exact object SHA256; scripts must be idempotent.
# `fail` keeps a node out of service on install failure; `warn` is only for
# non-critical extensions. Hooks run as root, so scope IAM to the exact object.
# Stable contract and operations: docs/aws-guide/18-s3-user-hooks.md
user_hooks:
  host:
    s3_uri: ""
    sha256: ""
    timeout_seconds: 300
    failure_policy: fail
  edge:
    s3_uri: ""
    sha256: ""
    timeout_seconds: 300
    failure_policy: fail

# ========== Multi-AZ HA ==========
# 跨 AZ 部署 ASG + ALB 实现高可用. 1.3.0 起默认开启 (生产推荐).
# az_count 控制最多使用几个 AZ; 实际数量受 region 可用 AZ 数限制.
# 关闭可减少跨 AZ 数据传输费用, 但会失去 AZ 级别的容灾能力.
multi_az:
  enabled: true
  az_count: 2

# 默认 `default_vpc` 保存量兼容(host 裸公网,不推荐;仅早期 demo/dev)。
# 生产走 `self_managed`:自建 /20 VPC + 3 公有子网(ALB/NAT GW)+ 3 NAT GW +
# 3 私有子网(host/edge/Redis 全在私有)。客户已有 VPC 就走 `imported`,
# 6 个 subnet id 必须齐——缺一 synth fail-loud(半配比隐性错更贵)。
network:
  mode: ""            # 留空=首次 setup.sh 时交互选择; 可选: default_vpc | self_managed | imported
  # self_managed 参数(mode=self_managed 时用):
  self_managed:
    cidr: "10.20.0.0/20"      # 4096 IP,3 AZ × (公 /24 + 私 /22) 富余
  # imported 参数(mode=imported 时用):
  imported:
    vpc_id: ""                 # 客户已有 VPC id
    cidr: ""                   # 客户 VPC CIDR(如 "10.0.0.0/16",用于 SG rule 引用)
    public_subnet_ids: []      # 3 个公有子网 id(ALB/NAT GW),数量必须与 multi_az.az_count 对齐
    private_subnet_ids: []     # 3 个私有子网 id(host/edge/Redis),数量同上

# 缺省全空/false:ALB 面向公网、子网按 network 模式自动选(向后兼容)。
alb:
  # #499 D — 本键【必须显式声明】,缺失即 fail-loud(ha_edge.py:1241 raise ValueError)。
  internal: false           # true=internal ALB(纯私有,不对公网);false=面向公网
  # 可选,显式指定 ALB 子网;空=按 internal/public 自动选。
  # #530 — 显式指定时【必须带 az】,写成 mapping:
  #   subnet_ids:
  #     - { id: subnet-aaa, az: ap-southeast-1a }
  #     - { id: subnet-bbb, az: ap-southeast-1b }
  # 理由:ALB 判 target 是否可用看的是 target 所在 AZ 有没有为该 ALB 启用,不是子网 id。
  # edge 实例落到 ALB 未启用的 AZ 后 target 永久 Target.NotInUse,健康检查也不会替换它
  # —— 那部分机队是死重,且不会自愈。裸 subnet id 经 CDK from_subnet_id 导入后 AZ 是
  # token,synth 期取不到具体值,于是这条不变量无法校验;因此裸 id 会被 fail-closed 拒绝。
  # edge.subnet_ids 同理。留空则由 ALB 的 AZ 集合自动派生 edge 子网,无需手写。
  subnet_ids: []

# OpenResty 边缘查 tenant_id→host:port 的准静态路由,host-agent 建/删/迁双写。
# 默认 false=不建(存量环境无 route.lua,零变化)。P7 部署新数据面时开 true。
# Multi-AZ replication group(automatic_failover + multi_az;跨 3 AZ 私有子网),
# primary endpoint DNS 下发到 host/edge(客户端每 30s 重解析,§8)。禁 auth_token
# (VPC 内 SG 隔离即够;auth_token 加密需 transit_encryption,拉长部署链)。
redis:
  enabled: true
  # Valkey = Redis OSS 的 BSD fork,协议/6379 端口与 Redis 客户端线级兼容,
  # 数据面 route.lua / host-agent redis-py 无需改。切引擎对存量路由集群是
  engine: "valkey"
  #
  #   `PRIVATE_ISOLATED` 分支;它在 4341c496 合入、当天被 e09245c2 误删,至今未补回)。
  #   `_helpers.py` 那层 Database(PRIVATE_ISOLATED)子网**仍然会建**,只是 Redis 不会自动选它。
  #   → 想让 Valkey/Redis 落隔离 DB 层,**必须在这里显式写那 3 个 DB 子网 id**
  #     (imported 模式另需 network.imported.database_subnet_ids 也传)。
  #   → 留空 = 回落 Private 层(PRIVATE_WITH_EGRESS),这是当前默认,为向后兼容刻意不改。
  #
  # ⚠️ 存量环境升级前务必钉死【本键】:若在役子网组的 SubnetIds
  #   与本次 synth 算出的集合不同,CFN 会下发 ModifyCacheSubnetGroup,而 ElastiCache
  #   **不允许改被在役 replication group 占用的子网组** → UPDATE_FAILED → 整栈回滚
  #   (2026-08-13 真机,#499 A1)。`scripts/preflight-check.sh` 已有该漂移判据会提前 BLOCK。
  #   ⚠️ 别用 existing_subnet_group_arn 指向【本栈自己建的】那个组来"钉死":配了它之后栈
  #   就不再声明 RedisSubnetGroup 资源,CFN 会去删这个仍被 replication group 占用的组 →
  #   删不掉 → 同样整栈回滚。那个键只适用于【栈外部管理】的子网组。
  subnet_ids: []
  node_type: "cache.r7g.large"  # 代码只读这个键,不要写 redis.instance_type(死键)。
  # engine_version 传 major.minor;补丁号(如 valkey 7.2.6)由 AWS 托管不显式指定。
  # valkey→"7.2";redis→"7.1"。参数组 family 自动取 <engine><major>(valkey7 / redis7)。
  engine_version: "7.2"
  num_replicas: 2             # 总节点数 = 1 primary + num_replicas replica
  # 下面两个键代码确实读取,不要误标为死键。
  #   传 ARN,代码取末段作 group name。空(默认)= 按上面 subnet_ids/engine 自建。
  #   ⚠️ 复用者自保:子网组须覆盖 ≥2 AZ(automatic_failover 要求);参数组 family 须匹配
  #      engine+major(valkey7 / redis7),不匹配 CreateReplicationGroup 400。
  existing_subnet_group_arn: ""     # 如 arn:aws:elasticache:<region>:<acct>:subnetgroup:<name>
  existing_parameter_group_arn: ""  # 如 arn:aws:elasticache:<region>:<acct>:parametergroup:<name>

# 独立 ASG(跨 3 AZ,不与 host ASG 混)。挂一台自动拉新——ELB health check
# 触发 → ASG terminate + launch → install-edge.sh 自举 → /healthz 就绪(nginx
# 起 + Lua route 缓存 warmup)。grace 覆盖冷启全程,防「起-杀循环」。
# 默认 false=不建(存量单 hub 路径继续跑)。开了必须 redis.enabled=true。
edge:
  enabled: false
  # 不要写 migration_drain_seconds:它是当前代码不读的死键,没有迁移 drain 配置开关。
  subnet_ids: []              # #272 — 可选,显式指定 OpenResty edge ASG 子网 id;空=PRIVATE_WITH_EGRESS 自动选。
  min_capacity: 3             # 一 AZ 一台起步,N-1 容灾
  max_capacity: 6
  instance_type: "c6in.xlarge"  # x86(apt openresty 直装,不折腾 arm64 交叉)
  health_check_grace_period_seconds: 300  # EC2 boot+apt+nginx+warmup;真机 P7 回填
  # host 数据面 DNAT 端口段上界(下界固定 10000)。edge→host 反代命中区间
  # [10000, dnat_port_high]。默认 15000 = 5001 槽:> 单 host 内存维度理论 576 VM
  # (768GB÷2GB×超卖比)+ stopped 租户保留端口 + 高流转缓冲,消除"端口先于内存耗尽"
  # 的隐形容量上限。改这里 = 改 SG 入站段 + host 端口位图(两者从此值同源,见 R1),
  # 须重建栈;不与内核 ephemeral 32768-60999 冲突。
  dnat_port_high: 15000

scaler:
  interval_minutes: 3
  idle_timeout_minutes: 10
  # 控制面重构阶段1 — lifecycle SQS 队列(削峰)。true=建 openclaw-lifecycle 队列
  # +DLQ+consumer Lambda,create/start/stop/delete 入队由 consumer 受控并发消费
  # (治同步直驱 SSM 在持续高并发下的雪崩,见 develop-dev/DESIGN-控制面重构)。
  # 默认 false=走原同步路径(向后兼容,小规模/demo 够用)。
  # ⚠ 大规模建租户必开,触发阈值远低于"千级":实测(2026-06-30)同步路径下
  # **仅 40 并发 POST /tenants 就有 11 个永久卡 creating**,根因是每租户一条
  # ssm.send_command 打同一 metal,超 SSM 单实例并发配额 → TimedOut → launch-vm 没跑。
  # 所以一次性建满 380/台(扩容、重建、压测)这类场景必须开本队列削峰,不是只有
  # 上线峰值才开(见 380 租户 SSM 并发压测结论)。
  lifecycle_queue_enabled: false
  # Phase 2 — 把 POST /tenants 建租户也走 FIFO 队列(默认 false=同步直驱,向后兼容)。
  # 开了之后:建租户做完廉价校验即入队返 202,consumer 按 lifecycle_consumer_concurrency
  # 限速逐个发 launch-vm 的 SSM,瞬时 380 建租户不再同步打爆 SSM 单实例并发墙。FIFO 的
  # MessageGroupId=tenant_id 保证不同租户并行消费(只同租户串行),所以削峰不串行化整批。
  # 需 lifecycle_queue_enabled=true(共用同一 FIFO 队列)。建租户端到端时延经 CloudWatch
  # OpenClaw/ControlPlane TenantCreateLatencySeconds 指标实测(1 分钟 SLA 守护)。
  create_via_queue: false
  # consumer 并发上限=限流阀,设到「SSM 单实例可承受的并发」而非越大越好。实测
  # 40 并发就触发 SSM TimedOut,故单 metal 场景应设到约 5-10(实测 SSM 单实例承受区间),
  # 不是 50;多 host 可按 host 数线性放大。瞬时千级入队、consumer 按此速率平稳消费。
  lifecycle_consumer_concurrency: 50
  # per-user 舰队反查索引 gsi_tenant_user(按 tenant_user_id 分区,供
  # GET/POST /users/{tenant_user_id}/* 反查该用户名下所有节点,见 stack.py:121 读取点、
  # handler.py:128 GSI_TENANT_USER 常量、handler.py:3800 反查 Query)。
  # 默认 false=不建该 GSI(/users/* 端点降级,核心租户 CRUD 不受影响)。
  # ⚠ DynamoDB 限制「一次 update 只能加 1 个 GSI」:首次部署若 gsi_owner 尚未 ACTIVE,
  # 本开关须保持 false 让 gsi_owner 先建好,待其 ACTIVE 后再设 true 单独触发一次
  # cdk deploy 加 gsi_tenant_user(分两步,见 stack.py:116-123)。
  # 键名必须是 add_gsi_tenant_user(改名前的旧键名已废,stack 不读)。
  add_gsi_tenant_user: false
  # Scale query indexes are cumulative rollout gates. Enable and deploy exactly
  # one new gate at a time because DynamoDB permits one GSI create per update.
  # Before every deploy run:
  # uv run --with boto3 --with pyyaml python
  #   scripts/checks/tenant-query-rollout.py --region <region>
  add_gsi_tenant_host: false
  add_gsi_tenant_status: false
  add_gsi_tenant_rootfs: false

tenant_query:
  # Enable only after all four tenant query GSIs report ACTIVE.
  enabled: false
  # Set only after tenant_rootfs_query_backfill.py --dry-run and apply complete.
  rootfs_backfill_complete: false

tenant_stats:
  # Explicit scan-cost gate. false creates no writer or minute schedule.
  enabled: false

# ========== SQS Dispatch(标准队列 + 装箱消费,治大规模建租户 SSM 打爆) ==========
# 与上面 scaler.lifecycle_queue_enabled(FIFO,治同租户下 lifecycle 有序)是并行两条
# 通道:lifecycle FIFO 继续管 stop/delete(需 per-tenant 严格有序),dispatch 标准队列
# 只管 create/start 的高并发装箱聚合。一期 push=聚合 SSM(单 host 一条命令带 batch
# manifest),二期 pull=写 assignments 表让 host-agent 自取。设计契约:
# SPEC/specs/sqs-dispatch/interfaces.md。ADR:
# engineering/00-knowledge-base/decisions/ADR-controlplane-sqs-batch-dispatch.md。
#
# 开关矩阵(interfaces.md L30):
#   dispatch.enabled=false → 什么都不建,现状不变(向后兼容)。
#   dispatch.enabled=true  → create/start 一律走 dispatch,scaler.create_via_queue 被忽略。
#   两者同 true             → stack.py synth 直接 raise ValueError(fail-loud,防双入队)。
# 迁移三步:
#   ① dispatch.enabled=false + create_via_queue=true 现状。
#   ② 排干 lifecycle 队列在途 create。
#   ③ 一次 deploy 里同时翻:dispatch.enabled=true + create_via_queue=false。
#
# 突发算术(打开前必算):esm_max_concurrency × 每批分片数 = 瞬时 PutParameter TPS。
# 大于 3 TPS 必须先给 Parameter Store 开 higher throughput,否则被 ParamStore 侧限流。
#
# andon 急停(不走本 config,走运行时 SSM param):
#   aws ssm put-parameter --overwrite --name /openclaw/dispatch/config --value 'andon=stop'
# 消费端每次 SendCommand/BatchWriteItem 前 GetParameter 单读(读失败 fail-closed)。
dispatch:
  enabled: false      # 默认关,零新资源
  # push=聚合 SSM+ParamStore 分片(回退,受 ~3 TPS PutParameter + 24KB 参数区限);
  #     PutParameter 退出热路径);pull=host-agent 5s 轮询自取(二期,无 SSM 叫醒)。
  mode: push          # 一期部署显式设 ddb;默认 push 保持存量部署零变化
  esm_max_concurrency: 10   # SQS Lambda ESM ScalingConfig MaximumConcurrency(硬 range 2..1000)
  batching_window_seconds: 2   # 攒批降 Lambda 冷启开销;0..300
  max_batch_size: 500   # 单次 invoke 里的最大装箱租户数;1..10000(推导 executionTimeout 也受制于此)
  dlq_max_receive_count: 3   # DLQ maxReceiveCount;一进 DLQ 就告警(alarm openclaw-dispatch-dlq-not-empty)

# ========== 健康检查 ==========
health_check:
  interval_minutes: 5
  max_failures: 3
  app_port: 18789
  # AZ-level failover (since 1.3.0). 当某个 AZ 内所有 host 在 unhealthy_threshold_minutes
  # 时间内一直 stale, 自动把该 AZ 的 running tenants 迁移到其他健康 AZ. 需要 multi_az.enabled=true.
  az_failover:
    enabled: true
    unhealthy_threshold_minutes: 10  # AZ 多久 (>=) 全停才触发, 防止短暂网络抖动误判
    cooldown_minutes: 30             # 同一 AZ 触发一次后, 多久才能再次触发

# ========== API Gateway 限流 (usage plan throttle) ==========
# api-key 维度的限流(operator 批量操作走它;自助用户走 Cognito 不走此 plan)。
# 旧默认 rate10/burst20 是规模化硬天花板:300 并发 POST /tenants 实测 173/300 撞 429。
# 上线峰值(每秒千级 lifecycle)须清过此值。per-IP 防护是下面 WAF 的 rate rule,与此正交。
api:
  throttle_rate_limit: 500          # 稳态 req/s(account 级 steady-state)
  throttle_burst_limit: 1000        # 瞬时 burst 上限(令牌桶容量)
  # 下面 private_api_enabled(true→both,false/未设→edge),保存量兼容。
  #   edge    = 只建 EDGE 公网 REST API(现状,浏览器/调试直连,不建 PRIVATE/VPCE)。
  #   private = 只走私有:建 PRIVATE API + 关联 execute-api Interface VPCE,机器流量
  #             全走 VPCE 内网;EDGE 仍建但挂 deny-public resource policy 断公网调用。
  #   both    = PRIVATE + VPCE + EDGE 并存(过渡态,与老 private_api_enabled=true 等价)。
  # mode: ""
  # true = 在现有 EDGE API 之外,再建一个 PRIVATE REST API 指向同一批 Lambda:
  #   endpoint_configuration=PRIVATE + 关联 execute-api Interface VPCE + 只允许该
  #   VPCE 的 resource policy(grant_invoke_from_vpc_endpoints_only,私有 API 无
  #   resource policy 无法 deploy)+ method 走 AWS_IAM 授权(调用方须 SigV4 签名 +
  #   execute-api:Invoke 权限)。机器/生产流量走私有,浏览器/调试走原 EDGE。
  #   from VPC CIDR。demo 见 docs/aws-guide 私有 API 加固附录 + SigV4 调用示例。
  private_api_enabled: false
  # 配了下面这段,每个平台拿一把独立 key + 独立 usage plan(per-platform 限流),
  # REQUEST authorizer 解析 key→platform 注入 requestContext.authorizer.platform_id,
  # 控制面按平台命名空间隔离(平台 A 的 key 碰不到平台 B 的租户,跨平台 403)。
  # 部署后须手动 seed PlatformKeyMap:create key → put {key_hash=sha256(key值), platform_id}。
  # 老 openclaw-admin-key 保留作运维超管(不在映射→无作用域→全量,仅内部运维)。
  # platform_keys:
  #   - id: acme                    # 平台标识(= 租户 platform_id 命名空间)
  #     throttle_rate_limit: 100    # 该平台稳态 req/s(缺省 100)
  #     throttle_burst_limit: 200   # 该平台 burst(缺省 200)
  #   - id: globex

# ========== AWS WAF (可选, 关联到 API Gateway) ==========
waf:
  enabled: false                   # 启用后保护 API Gateway 免受常见攻击
  rate_limit_per_ip: 1000          # 每 IP 5 分钟内的请求数上限 (超过则 block)
  managed_rules:                   # AWS 托管规则集 (下面这些之外, stack.py 总会再
    - AWSManagedRulesCommonRuleSet # 自动加 SQLiRuleSet + AmazonIpReputationList
    - AWSManagedRulesKnownBadInputsRuleSet  # 作为不可被裁掉的安全底线)

# ========== VPC Flow Logs (CIS 3.8 — 网络层审计) ==========
# 抓 VPC 内所有 ENI 的 accept+reject 流量到 CloudWatch Logs, 作为多租户主机
# 集群的网络审计轨迹 (谁和谁通信, 跨租户隔离的取证证据)。默认开启; 缺省该段
# 时 stack.py 也按 enabled: true 处理 (安全默认)。
flow_logs:
  enabled: true                    # 关掉只在受限测试账号省成本时考虑
  retention_days: 90               # CloudWatch 保留天数 (7/14/30/60/90/180/365)

# ========== AgentCore (可选) ==========
agentcore:
  enabled: false                   # 开启后所有 VM 自动连接 AgentCore
  # gateway:
  #   enabled: true
  # memory:
  #   enabled: true
  #   strategies: [semantic, user_preference]
  #   expiration_days: 90
  # code_interpreter:
  #   enabled: true
  # browser:
  #   enabled: true

# ========== Console 认证 (可选) ==========
# console_auth.enabled 默认关(false),整个 Cognito 段随 gate 全体休眠,可回退。
# 下一版将进一步删掉 Cognito 段本身;此处保留仅供 console 面 SSO 需求场景启用。
console_auth:
  enabled: false                   # 开启后 Console 需要 Cognito 登录(#187 P5 硬默认关)
  # console_auth.user_pool_id 由 setup.sh 自动判定并写入,不要手填。它只应出现在
  # 真正的 1.1.x→1.2.x legacy User Pool 升级路径,普通新部署/重跑不需要。
  self_sign_up: false              # 允许用户自注册
  rbac_enabled: true               # 角色鉴权(viewer/operator/admin)开关, 独立于登录; 安全默认 true(上线最小权限); 仅 demo/dev 想要全开放才显式设 false
  # 无 Bearer token 的纯 API-key 请求(不带 Cognito id_token)落到的兜底角色。
  # 安全默认 viewer=只读(fail-safe,见 handler.py DEFAULT_NO_JWT_ROLE 注释):要写
  # 操作必须带 Cognito id_token。放宽到 operator/admin = 任何持 API key 者无需登录即可
  # 写/改,等于削掉一层门控,仅在受信内网自动化等明确场景才放宽,生产保持 viewer。
  default_no_jwt_role: viewer
  # openclaw-console-bff Lambda + Lambda 目标组;再配下面的【区域内】ACM 证书 ARN
  # 才在 DashboardALB 上开 443 listener + authenticate-cognito 登录门
  # (/console/* 与 /capi/* 先过 Cognito Hosted UI 登录再转发 BFF)。不配证书则
  # BFF 就位但不接流量(ALB 的 authenticate-cognito 只能挂 HTTPS listener)。
  # 真 admin key 不进 IaC 模板:部署后由 setup.sh 写入 Lambda env CTRL_API_KEY。
  bff_certificate_arn: ""
  bff_domain: ""                   # BFF 对外域名(Cognito OAuth 回调);留空用 ALB DNS
  bff_subnet_ids: []               # 可选,显式指定 BFF Lambda 子网 id;空=PRIVATE_WITH_EGRESS
  # (逗号分隔,如 "203.0.113.0/24,198.51.100.7/32")。默认空 = 不开 443 入站(fail-safe,
  # 门建了但墙上不开洞)。绝不填 0.0.0.0/0(synth 会炸,AWS 暴露红线);填自家办公/VPN 出口。
  bff_ingress_cidrs: ""
  # 保留字段防呆:openclaw-tenant-secrets 老残留字段清理 UpdateExpression 仍幂等
  # REMOVE)。历史 ADR 见 engineering/04-archive/p5-cognito-channel-deprecated/。
  channel_cognito_auth: false

# 控制面 DynamoDB 表的时间点恢复(PITR)。覆盖 tenants/hosts/groups/audit 四张 RETAIN 表
# (短命的 batch-jobs 是 DESTROY+TTL,不开)。开后 DynamoDB 维持连续备份,可恢复到恢复期内
# 任意秒级时点 —— 控制面元数据误删/坏写后能回滚。stack.py 默认即 true(留空也开),此处仅显式可调。
deploy:
  # 有状态资源(DDB 表 / backup / audit 归档桶)的删除策略开关。
  #   true  = RETAIN + WORM Object Lock(数据安全,生产用)
  #   false = DESTROY + auto-delete("删栈即可干净重建",可反复重建的测试环境用)
  #   不设(注释掉) = 回落旧默认: region==ap-southeast-1 视为生产=保护,其余=可销毁。
  # 病根修复: 旧代码把"是否保护"硬编码绑死在 region 名上,导致一个被当成"生产"
  # 的 region 每次删栈都留 RETAIN 残留 + WORM 桶删不掉,重建反复撞 already exists。
  # 显式声明环境属性后,测试型 ap-southeast-1 也能 teardown+rebuild 收敛。
  protect_stateful_resources: false

dynamodb:
  point_in_time_recovery: true     # 控制面表 PITR 总开关; 安全默认 true
  recovery_period_in_days: 35      # 连续备份保留天数; DynamoDB 上限 35

audit:
  retention_days: 90               # 审计表条目 DDB TTL 自动过期天数
  # Phase 3 (CIS 2.2.2):审计表用客户托管 CMK 加密(默认 false=AWS-owned key)。
  # ⚠ 只能在全新 account 首次部署时开:审计表是 RETAIN,对存量表在线切加密会强制
  # replace 丢审计历史。开了会新建 alias/openclaw-audit-log CMK(自动轮换),Lambda
  # 的 grant_read_write_data 自动获得 kms 解密权限。
  cmk_encryption: false
  # audit-archive S3 桶(Object Lock COMPLIANCE + Versioning + 独立 CMK)保留数年。
  # 归档链路:DDB Stream(NEW_IMAGE)→ 归档 Lambda → S3 按 owner/date/id.json 分区。
  # 同时给 audit 表加 gsi_audit_owner(actor_owner_id, ts)让按租户查审计走 GSI 不再
  # 全分区扫。
  # ⚠ 与 cmk_encryption 相同硬约束:只能在全新 account 首次部署时开(存量 audit 表
  # 加 Stream + GSI 会强制 replace 丢历史)。dev region 走 DESTROY 降级不锁 WORM。
  worm_archive_enabled: false
  # WORM 桶 Object Lock retention(prod region);默认 7 年对齐 SEC 17a-4 常见口径
  worm_retention_years: 7
  # S3 分区前缀
  archive_prefix: "audit-archive"

# Go-live A1: 租户↔用户映射的写权威外置给外部后端(external backend)。enabled=true 时:① create_tenant
# 不再隐式让创建者(Cognito sub)拥有租户;② 外部后端经 HMAC 签名的 POST /external/authz
# 写 grant/revoke 到 authorized_users(我方 DDB 只缓存外部后端的授权决定)。默认关=现有行为。
external_authz:
  enabled: false                   # true=映射写权威外置给外部后端
  secret_name: ""                  # Secrets Manager 里的 HMAC 共享密钥名(外部后端签名用);走 CFN 动态引用,明文不进模板
  # user_pool_id: ""              # 复用已有 User Pool（留空自动创建）

# ========== 外部 IdP 联合 (可选, OIDC) ==========
# 依赖 console_auth.enabled=true (provider 挂在 console 的 User Pool 上)。
# enabled=false (默认) 时不加任何 provider, User Pool 保持 COGNITO-only, 完全向后兼容。
#
# 注意: 这里只提供"接入点 + 契约", 外部真实 OIDC 端点 (issuer/client) 由外部 IdP 侧提供,
# 我方不硬编造。client_secret 走 Secrets Manager 动态引用, 明文绝不进 CloudFormation 模板。
#
# 联合对 hub 透明: hub 仍只验 Cognito 签发的 id_token (零凭据 guest 约束不变)。
# attribute mapping 把外部平台稳定 id (默认 OIDC `sub` claim) 映到 Cognito 自定义属性
# custom:tenant_user_id; Cognito 自身生成的 sub 作为租户 owner_id。
exchange_idp:
  enabled: false                   # 开关; false 时下面字段全部忽略
  # provider_name: "ExchangeIdP"      # Cognito 里该 provider 的名字 (hosted-UI 按钮 + supported 列表)
  # issuer_url: ""                 # 【外部 IdP 侧提供】OIDC issuer URL, 留空=不启用 (CDK 自动发现 .well-known)
  # client_id: ""                  # 【外部 IdP 侧提供】OIDC client id
  # client_secret_secret: ""       # client secret 所在的 Secrets Manager 密钥名/ARN (不写明文!)
  # client_secret_json_key: ""     # 若密钥是 JSON, 取哪个 key; 纯字符串密钥留空
  # scopes: ["openid", "profile", "email"]   # 向外部 IdP 请求的 OAuth2 scopes
  # stable_id_claim: "sub"         # 外部 IdP 端稳定用户 id 所在的 OIDC claim, 映到 custom:tenant_user_id
  # attribute_request_method: "GET"  # GET | POST, IdP userInfo 端点的请求方法
  # map_email: true                # 是否把 email claim 也映到 Cognito email 属性

# ========== CloudFront 自定义域名 (可选) ==========
# 1.3.4+ 推荐使用双域名模式分离 console 和 tenant dashboard，物理隔离 Cognito
# session 与租户应用代码（防 XSS / cookie 跨域风险）。
#
#   双域名模式（推荐生产用）：
#     ./setup.sh <region> <profile> \
#       --console-domain console.example.com --console-cert <acm-arn> \
#       --app-domain     app.example.com     --app-cert     <acm-arn>
#
#   单域名模式（legacy / dev-only）：
#     ./setup.sh <region> <profile> --domain <domain> --cert <acm-arn>
cloudfront:
  # 场景用(私有部署 / console 走内网 ALB);缺省 true 向后兼容。
  enabled: true
  # ----- 双域名模式（v1.3.4+ 推荐） -----
  console_domain: ""               # 例: console.aws.xin（操作员控制台）
  console_cert_arn: ""             # us-east-1 ACM cert ARN
  app_domain: ""                   # 例: app.aws.xin（per-tenant dashboard）
  app_cert_arn: ""                 # us-east-1 ACM cert ARN
  # ----- 单域名模式（legacy 兼容） -----
  custom_domain: ""                # 例: claw.aws.xin，留空则使用默认 *.cloudfront.net
  acm_cert_arn: ""                 # us-east-1 ACM 证书 ARN (CloudFront 必须 us-east-1)

# ========== Lifecycle Notifications (可选, SNS) ==========
# 启用后, API Lambda 在 tenant 创建/删除/启停等事件时 publish 到 SNS topic
# 操作员可订阅该 topic (Email, SQS, Lambda, HTTPS) 实现实时通知
notifications:
  enabled: false                   # 启用后创建 openclaw-tenant-events SNS topic
  # 部署完成后从 NotificationsTopicArn output 订阅

# ========== 运行时 metrics 后端 ==========
# enabled=true 开 metrics 采集(host-agent :8899/metrics)。后端二选一:
# edge 指标在 :9145,包含 edge_up、edge_connections{state=...}、
# edge_worker_processes;旧地址 :8080/metrics 实测返回 404,不要配置 Prometheus 抓它。
#   - 默认(use_managed 缺省 false)= 自建 EC2 Prometheus+Grafana(deploy/monitoring/,
#     运维手册 §5.6),不建任何 AWS 托管 workspace。这是本项目既定架构(AMG 要 AWS_SSO,
#     刻意规避)。实测 AMP workspace 为空,正是走自建。
#   - use_managed=true = CDK 建 Amazon Managed Prometheus(AMP)+ Managed Grafana(AMG,
#     强制 AWS_SSO)+ host_role 的 aps:RemoteWrite 权限。想用 AWS 托管再显式开。
metrics:
  enabled: true
  use_managed: false               # false=自建Prom/Grafana(默认); true=AMP+AMG托管

# Wazuh 监控数据平台聚合三源:① in-guest auditd/FIM 告警(镜像已烤,见 build-rootfs)
# ② GuardDuty 云层威胁检测 ③ openclaw 运行时 metrics(host-agent → AMP)。
security:
  # false(默认)= 不建 ClawPoolCMK,synth byte-identical(存量栈零变化)。
  # true = 建 alias/clawpool-general CMK(轮换开),key policy 权限分离:host role
  #   只 Decrypt(host 在 VM 启动时解密上游注入的凭据密文),API/上游各自另授。
  #   部署后 CDK 输出 ClawPoolCmkArn,交给上游服务在调 API Gateway 前用它加密凭据
  #   (EncryptionContext 绑 tenant_id,见 core/kms_envelope.py 与 launch-vm 解密段)。
  #   测试期可先用一把手工指定的 CMK 加密验证链路,部署后切成本栈输出的 ARN。
  clawpool_cmk_enabled: false
  guardduty_enabled: false   # true=CDK 启 GuardDuty detector + 把 Finding 经 EventBridge 路由到 SNS(供 Wazuh/订阅者消费)。账号已有 detector 时保持 false。
  guardduty_runtime_monitoring: false   # true=在 detector 上启 RUNTIME_MONITORING feature,同时把 EC2_AGENT_MANAGEMENT 显式设为 DISABLED —— 开 automated agent management 会给账号内所有 EC2 装 GuardDuty agent(SSM association),会波及本栈之外的 host。安全开启法:只给需要监控的实例打 inclusion tag GuardDutyManaged=true(或反向给不想装的 host 打 exclusion tag GuardDutyManaged=false)。account 层威胁检测(GD 自身的 9 feature)不受此开关影响,一手证据 engineering/evidence/metal-experiments/8layer-evidence.md:163-181。前置:guardduty_enabled: true。默认 false。
  inspector_enabled: false   # true=在本 region 启用 Amazon Inspector v2(经 AwsCustomResource 调 inspector2:Enable),对 EC2/ECR 做 CVE 与配置扫描,Finding 经 EventBridge 路由到 SNS。默认 false:Enable 是账号级动作(按扫描资源计费),建议由账号运营方显式打开。stack destroy 时会 Disable。
  inspector_resource_types: ["EC2", "ECR"]   # inspector_enabled=true 时扫描的资源类型。可选 EC2/ECR/LAMBDA/LAMBDA_CODE/CODE_REPOSITORY。默认覆盖 host CVE(EC2) + 镜像 CVE(ECR)。
  wazuh_enabled: false       # true=CDK 起一台专用监控 EC2(m7i.xlarge/AL2023),userdata 自动装 docker+compose 跑 Wazuh manager/indexer/dashboard,从 assets bucket 拉 deployment/monitoring/*。SG 仅 VPC CIDR 入站(1514/1515/55000/443,绝不 0.0.0.0)。默认 false。
  # Wazuh manager 部署见 deploy/monitoring/WAZUH-RUNBOOK.md(docker-compose 起 manager+indexer+dashboard,in-guest agent forward)。
  dns_firewall_enabled: false  # true=CDK 建 Route53 Resolver DNS Firewall(domain list openclaw-egress-blocklist + rule group openclaw-egress-fw + BLOCK 规则 NXDOMAIN + 关联 VPC),在 DNS 解析层拦 C2/外泄域名(L4 出网防线)。默认 false。真实 C2 域名清单不入仓库(domain list 只放 demo 占位),运营用 route53resolver import-firewall-domains 从受控威胁情报源另灌。此前由 apply-hardening.sh 旁路建,现纳入 stack.py 随重建对账。注意:DNS FW 只拦经 VPC Route53 Resolver 的查询;microVM guest DNS 硬编码公网 8.8.8.8 不经 VPC Resolver,故 DNS FW 对 microVM 出网无效(定位=带外 C2 黑名单)。收 microVM 出网走下面的 egress_allowlist(#39,tap 级 iptables 白名单)。
  guardrail_managed_by_stack: false  # true=CDK 用 aws_bedrock.CfnGuardrail 从 deploy/runtime-config-export/bedrock-guardrail.json 建 Bedrock Guardrail,id 写 SSM /openclaw/bedrock-guardrail-id(LiteLLM userdata/apply-hardening.sh 都从 SSM 读、不硬编码)。默认 false 保存量兼容——存量账号已有 apply-hardening.sh 建过的 Guardrail 时保持 false,LiteLLM 在 SSM 缺失时按仓库 Guardrail 名精确发现 id。切 true 前必须先把带外那个 Guardrail 改名或删了,否则 CFN 建同名 Guardrail 冲突。#80。

  # false(默认)= 现状:launch-vm.sh 末尾 FORWARD ACCEPT 放行 guest→全部公网出网(零变化)。
  # true = 把末尾 ACCEPT 换成「静态 CIDR 放行 + FQDN 白名单放行 + 末尾 DROP」默认拒绝。机制:
  #   ① 静态 CIDR:自动放行 VPC CIDR(覆盖 host 本地 hub tap IP + 堡垒机 LiteLLM 私网 + EKS ALB
  #      私网),+ 下面 egress_allowlist_cidrs 的自定义 CIDR。
  #   ② FQDN 白名单:host 起 dnsmasq,用 nat/PREROUTING DNAT 把 guest 的 :53 透明劫持到 host
  #      dnsmasq(guest DNS 硬编码 8.8.8.8 无需改,零 guest 改造/不重烤镜像);dnsmasq 对内置
  #      cognito-idp.{region}/s3.{region} + 下面 egress_allowlist_domains 边解析边灌 ipset
  #      oc_egress_allow,FORWARD 用 -m set --match-set 放行解析出的真实 IP。cognito-idp 在
  #      ip-ranges.json 无独立 service key(只落 AMAZON 大段),故走 FQDN 白名单精确放行,不放整段。
  #   ③ 末尾对 tap→公网口补 DROP 兜底(默认拒绝);直连 IP 绕过 DNS 白名单的也被这条 DROP 兜住。
  # 为什么默认关:开启会切默认拒绝,漏放一个必需目标(cognito/LLM/hub/S3 图片链路)microVM 即
  #   不可用,误伤面大,须先在真机满载 380 逐条验证放行/拦截都对再灰度开启(改部署代码→重建,非热改)。
  # 精确到 bucket 级 / 复活 R53 DNS FW / VPC Endpoint 收敛需改 guest DNS + 重烤镜像,留独立 ADR。
  egress_allowlist_enabled: false
  egress_allowlist_include_vpc_cidr: true   # gate 开时是否自动放行整个 VPC CIDR(覆盖 LiteLLM/EKS hub/VPC endpoint 私网)。默认 true。
  # 额外放行的自定义 CIDR(逗号分隔,如堡垒机所在的对等 VPC / 独立 LiteLLM 子网)。VPC CIDR 已自动放行。
  egress_allowlist_cidrs: ""
  # 额外放行的 FQDN(逗号分隔,叠在内置 cognito-idp/s3 默认域名之上;如 finance-agent 的第三方行情 API 域名)。
  egress_allowlist_domains: ""
  # host dnsmasq 的上游解析器。默认沿用 guest 原硬编码 8.8.8.8 便于对齐;可改 VPC Resolver 169.254.169.253。
  egress_dns_upstream: "8.8.8.8"
  # #517 阶段3(G1 fail-closed)—— 只读身份盘(openclaw-immutable.ext4:7 个身份 md + ops skills)
  #   缺失时是否【拒绝启动】该 microVM。默认 false = 既有兼容行为:launch-vm.sh 打 WARN 后照常
  #   起,guest 回落到 data 盘里【烤制当天】的旧 md 副本 + 开机 bind-mount 遮盖失效 → agent 读到
  #   旧身份而控制面无任何告警(§4 G1 的静默旧副本)。开 true 后盘缺失 → launch-vm.sh exit 1,
  #   宁可这台起不来也不静默跑错身份。改部署代码→重建生效,非热改。
  immutable_disk_required: false

# ========== claw-hub 端点(microVM channel dial-out 目标)==========
# 每个 microVM 的 claw-channel 拨出到 hub 注册(jarvis 同款 outbound WS)。
# 默认走 host 本地 tap IP 上的 hub(单 host 自包含,向后兼容)。配 alb_dns 后,
# launch-vm.sh 注入的 HUB_URL/HUB_WS 改指 EKS hub ALB —— 节点重建即继承,
# 这是"切 EKS 生产流量"的长期做法(改部署代码→重建,非热改运行中 VM)。
# 留空=metal 本地 hub(默认)。这是 ②EKS 灰度切生产流量的唯一开关。
hub:
  alb_dns: ""                      # 例: k8s-clawhub-clawhub-xxxx.ap-southeast-1.elb.amazonaws.com (EKS hub Ingress ALB DNS)。留空=metal 本地 hub。
  alb_scheme: "ws"                 # ws | wss。EKS ALB 加 ACM 证书后改 wss(配 deploy/eks/claw-hub.yaml 的 TLS annotation)。
  alb_port: 80                     # ALB 监听端口。HTTPS(wss)时改 443。

# ========== AI Gateway(LiteLLM)开关 ==========
# guest microVM 零凭据,LLM 调用经一个 OpenAI 兼容网关(LiteLLM)→ Bedrock。
# #480 三态语义(默认「不部署」):
#   ① url 填了               = 复用已有网关,CDK 只把它写进 SSM /openclaw/litellm-host。
#   ② url 空 + managed_by_stack=true = CDK 自己起一台 LiteLLM(单机;ha_enabled=true 时是
#                                     ASG+ALB+RDS 那套),起来后把地址写 SSM。
#   ③ url 空 + managed_by_stack=false(默认) = 什么都不建、不写 SSM。
#   → 默认不部署:多数部署已有自己的 OpenAI 兼容网关,旧默认(url 空即自动起一台常驻 EC2,
#     HA 还多一套 RDS Multi-AZ + internal ALB)对这些环境是净负担。要 CDK 托管一个,
#     显式把 managed_by_stack 设 true;或直接填 url 复用外部网关。
#   → 不部署对 host 引导无害(init-host.sh 读 SSM 带 || echo "" 兜底,参数缺失只是 env 为空,
#     不会引导失败)。可见后果:guest agent 没有模型端点可调 —— 未配网关时这是预期,不是 bug。
ai_gateway:
  # #480 默认 false = 不由本栈托管 LiteLLM。true = CDK 起一台(见 ha_enabled 决定单机/HA)。
  # 仅当 url 为空时此开关才起作用;url 非空时始终走「复用外部网关」,与本开关无关。
  #
  # ⚠ 存量升级必读:若你的现有部署此前靠「url 空即自动起 LiteLLM」跑着一台在役网关,
  #   升级到本版后 config.yml 缺 managed_by_stack(视同 false)→ 下次 cdk deploy 会
  #   删掉那台在役 LiteLLM。要保持现状,升级前把本项显式设 true。注意 host userdata
  #   自写的 SSM /openclaw/litellm-host 不受 CFN 管理,网关被删后该值会残留并指向已
  #   释放的私网 IP(guest 调用将连不上),需一并手工清理或改指新网关。
  managed_by_stack: false
  # 已有网关就填它的 base URL(如 http://10.0.0.10:4000/v1),CDK 直接写进 SSM
  # /openclaw/litellm-host 给 host 用。留空 + managed_by_stack=true = CDK 自动起一台
  # LiteLLM EC2(最小权限 bedrock instance role,无静态 key),起来后把私网 IP 写 SSM。
  # 生产 ap-southeast-1 可填已有堡垒机网关复用。
  # R15.1(N4):填全 URL 时协议按写的来 —— 纯 IP/host(如 10.0.0.10)会被
  # 规范化成 http://<host>:4000/v1;要 HTTPS/TLS 网关直接写完整 https URL
  # (如 https://gw.internal/v1),原样透传不再被硬拼成 http:4000。只改默认端口/
  # path(纯 host 输入时)用 host 侧 env LITELLM_PORT/LITELLM_PATH(harden-config 派生)。
  url: ""
  instance_type: "c7i.large"       # 自动起网关时的机型(仅 url 空 + managed_by_stack=true 时用)。
  # (1 台 EC2 + compose 内嵌 PG),true 走 HA 路径 —— ASG min=2 跨 AZ + internal ALB 前置
  # 4000 + 独立 RDS PostgreSQL Multi-AZ 共享 vkey/spend 表(compose 内嵌 PG 用 profile
  # 屏蔽,两台实例各存一份表会分裂,ALB 轮询命中不同实例时 vkey mint 一半失效)。
  # SSM /openclaw/litellm-host 直接写 internal ALB DNS, userdata 不再自写 SSM。
  ha_enabled: false

# ========== Per-tenant LLM billing / 限流 ==========
billing:
  # 代码确实读取此 Secrets Manager secret 名称/ARN,从中取得 LiteLLM master key,
  # 再为每个租户调用 /key/generate 铸带 budget/rpm 的 vkey。留空=不铸 vkey,
  # VM 仍可正常启动但租户共用上游 key,没有 per-tenant 预算/限流,也无法按租户
  # 对账 LLM 花费。LiteLLM 必须连接 PostgreSQL 才能铸 key;未接 DB 时
  # /key/generate 会返回 HTTP 500 DB not connected。
  master_key_secret: ""

# ========== 黄金镜像 ==========
# 拆出主 stack 且非阻塞:build 失败只回滚 OpenClawImage,不连累控制面/数据面。
# 主 stack 不再依赖镜像就绪 —— 全新 region 首个 host 可能抢在镜像烤好前启动、
# lifecycle-hook 超时 churn 几分钟(非部署失败),镜像烤完自愈。
image:
  version: "v1.0"                  # 黄金镜像版本(CodeBuild 烤 + manifest 校验对齐)。
  build_in_stack: true             # true=部署 OpenClawImage stack 触发 CodeBuild 烤镜像(非阻塞,#283);
                                   # false=跳过(沿用桶里已有镜像,或自己跑 build-rootfs-on-ec2.sh)。

# Fluent Bit(edge)→ Kinesis Data Firehose → Amazon OpenSearch Service
# 与 Wazuh 告警域(deploy/monitoring/wazuh-two-ec2/)绝不共域(design decision
# 硬红线):安全审计与运维日志故障+权限隔离。guest microVM 内零凭据零 agent,
# 采集只在 host/edge 侧(L5 卖点,SHALL NOT 破坏)。
#
# 尺寸默认取最小可上线的形状(2 数据节点 + 无专用主节点)。真实 sizing 必须
# 在采样 edge 日志流量后按 spec §6.1 F 表校准,不改这里默认。
#
# 门 logging.enabled=false 时整段零资源(synth 与不加载本模块等价)。
logging:
  # true=建 AOS 域 + 三条 Firehose(edge/host/vm)+ Log_Archive_Bucket,并让
  # 三个索引 claw-logs-{edge,host,vm}-*:edge=nginx access log,host=journald
  # (host-agent + 生命周期脚本),vm=每租户 fc.log(带 tenant_id)。索引名/流名不
  # 可调(确定值),要调只调下面 sizing。
  # 两步部署:先设 true 建日志资源,再替换 host/edge 实例(或做 instance refresh)。
  # 实例只在启动时按当时资源是否存在决定是否安装 Fluent Bit;从 false 改 true
  # 增量部署不会让存量实例追溯生效,不换机就不会真正送日志。
  enabled: false
  aos:
    subnet_ids: []                                # #272 — 可选,显式指定 OpenSearch 域子网 id;空=PRIVATE_WITH_EGRESS 自动选(数量须与 az_count 对齐)。
    # aws ec2 describe-vpc-endpoints --region <R> --filters Name=vpc-id,Values=<VPC> \
    #   --query 'VpcEndpoints[?contains(ServiceName,`secretsmanager`)].[VpcEndpointId,PrivateDnsEnabled]'
    # 查到已有开 private DNS 的 secretsmanager VPCE → false 复用;查不到 → true 自建。
    # 同 VPC 同服务只允许一个 endpoint 开 private DNS,重复建会让整栈 ROLLBACK。
    # 开 private DNS 后,secretsmanager.<region>.amazonaws.com 在整个 VPC 都解析到
    # 该私有端点;堡垒机、host、其它 Lambda 和客户负载都必须被 VPCE SG 放行,
    # 否则它们访问 Secrets Manager 会静默中断。
    create_secretsmanager_vpce: true              # #309 — 建 secretsmanager Interface VPCE 供 AOS rolesmapping Lambda 取口令。VPC 里已有一个开 private DNS 的 secretsmanager VPCE(残留/客户自建)时设 false 复用它(AWS 同服务同 VPC 只许一个开 private DNS,否则整栈 ROLLBACK)。
    data_node_instance_type: "r6g.large.search"   # 日志型写多读少,内存型优于 m 系
    data_nodes: 2                                 # 与 AZ 数取整数倍;≥3 才达 HA 底线(Multi-AZ)
    master_node_instance_type: "m6g.large.search"
    master_nodes: 0                               # 0=无专用主节点(demo);3=HA 硬门,其它值 CDK 拒
    ebs_volume_size_gib: 100                      # gp3;起步 80% 水位,CloudWatch 排队再调
  firehose:
    buffering_interval_seconds: 60                # 0-900,越小实时越好但请求数↑成本↑
    buffering_size_mib: 5                         # 1-100 MiB
    retry_duration_seconds: 300                   # 0-7200,超时 → FailedDocumentsOnly → S3
  log_archive_bucket:
    retention_days: 90                            # Firehose 失败文档 + 未来 ALB access log 归档期
