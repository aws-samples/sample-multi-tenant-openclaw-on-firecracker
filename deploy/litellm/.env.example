# LiteLLM 栈环境变量范本。复制成 .env 并填真值（litellm-up.sh 会自动生成缺失项）。
# 真 .env 权限 600、不进仓库（见 .gitignore）。所有密钥用 openssl rand 现生成，不从旧账号迁。

# 管理 API 根凭据。空着让 litellm-up.sh 用 `openssl rand -hex 32` 现生成并写回 .env(600)。
# 绝不硬编码、绝不复用旧账号的 master_key。这是测试值，上线前轮换。
LITELLM_MASTER_KEY=

# Postgres（spend/vkey 持久化）。空着让 litellm-up.sh 现生成。
POSTGRES_USER=litellm
POSTGRES_PASSWORD=
POSTGRES_DB=litellm

# Bedrock region（instance role 调 Bedrock，不放 AWS key）。
AWS_REGION=ap-southeast-1

# 部署时注入到 config 的 Bedrock Guardrail ID（litellm-up.sh 把 __GUARDRAIL_ID__ sed 成此值）。
#  新账号 = od6s8sm533fs（claw-ai-chat-exchange-grade，DRAFT，OWASP 5 层）。
GUARDRAIL_ID=od6s8sm533fs
