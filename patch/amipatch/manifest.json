        "ver-485"
      ]
    },
    {
      "id": "fix-488",
      "summary": "0→1 部署前置门补齐 + 示例配置自相矛盾修正(min_capacity 首次部署必须 0;imported VPC + metal 实测 lifecycle_hook_timeout 1200s 不足,改 3600)",
      "paths": [
        "config.yml.example",
        "samples/config-sg-prod.yaml",
        "scripts/preflight-check.sh"
      ],
      "applies_when": "仅当目标环境要重新执行 0→1 部署;在役机队不应用 min_capacity=0",
      "params_changed": [
        {
          "name": "asg.min_capacity -> HostASG.MinSize",
          "layer": "D-cdk",
          "old_default": "2",
          "new_default": "0",
          "runtime_impact": "示例配置里这是【首次部署】才对的值(黄金镜像烤制是非阻塞独立栈,min>=1 时 host 抢在镜像就绪前启动、拉不到镜像 → lifecycle ABANDON → ASG 反复换机)。对【在役】机队执行 --min-size 0 会允许缩到零台,承载真实租户的 host 可能被回收。本 patch 不生成强制操作,仅作可选建议。"
        },
        {
          "name": "asg.lifecycle_hook_timeout -> InitHook.HeartbeatTimeout",
          "layer": "D-cdk",
          "old_default": "1200",
          "new_default": "3600",
          "runtime_impact": "放宽方向,安全。imported VPC + r8g.metal-24xl 真机实测 1200s 不足,会连续 lifecycle ABANDON 换机。改大只影响钩子等待上限,不影响在役实例。"
        }
      ],
      "verification_ids": [
        "ver-488"
      ]
    },
    {
      "id": "fix-495",
      "summary": "tenant-query GSI 门误拦首次部署:表不存在时代入空索引,missing 变成全部 GSI,触发 at most one 报错,一键部署整条被堵。CFN 建新表时一次性连所有 GSI 一起建,故表不存在时直接放行",
      "paths": [
        "deploy/stacks/tenant_query_rollout.py",
        "scripts/checks/tenant-query-rollout.py"
      ],
      "applies_when": "仅当目标环境的 tenant-query 表尚不存在(首次部署)",
      "params_changed": [],
      "verification_ids": [
        "ver-495"
      ]
    }
  ],
  "verifications": [
    {
      "id": "ver-440",
      "fix_id": "fix-440",
      "phase": "B-lifecycle",
      "action": "在新 AMI 起的 host 上确认 fluent-bit 装成功(keyring 已存在也不再卡覆盖确认) — systemctl is-active fluent-bit && ls -l /usr/share/keyrings/fluentbit*.gpg",
      "observable": "systemctl is-active fluent-bit && ls -l /usr/share/keyrings/fluentbit*.gpg",
      "pass_when": "fluent-bit active 且 keyring 存在",
      "fail_when": "install-fluent-bit.sh 返回 rc=2,或 host 卡在 lifecycle 钩子直到 ABANDON",
      "timeout_s": 1800,
      "cleanup": "删除本检查创建的测试租户,按创建时记录的确切 id 逐个删,不用前缀 glob"
    },
    {
      "id": "ver-445",
      "fix_id": "fix-445",
      "phase": "A-readonly",
      "action": "重跑 init-host 后 openclaw-hosts 的四个运行时记账字段不被抹回初值 — 对同一 host 记录前后各读一次 used_vcpu/used_mem_mb/vm_count",
      "observable": "对同一 host 记录前后各读一次 used_vcpu/used_mem_mb/vm_count",
      "pass_when": "重跑后计数器保持事实值",
