#!/usr/bin/env python3
import sys

sys.dont_write_bytecode = True

import argparse
import json
from pathlib import Path

HERE = Path(__file__).resolve().parent
if str(HERE) not in sys.path:
    sys.path.insert(0, str(HERE))

from checks import CHECKS, OFFLINE_CHECKS
from lib.awsread import AwsReadError, AwsUnavailable, ReadOnlyViolation
from lib.context import ContextError, ValidationContext, add_arguments
from lib.result import exit_code, finding, flatten, report_document


def _parser():
    parser = argparse.ArgumentParser(
        description="Read-only pre-launch patch validator")
    add_arguments(parser)
    return parser


def _groups(raw):
    if not raw:
        return {"A", "B", "C", "D", "E"}
    groups = {item.strip().upper() for item in raw.split(",") if item.strip()}
    invalid = groups.difference({"A", "B", "C", "D", "E"})
    if invalid:
        raise ContextError("unknown groups: %s" % ",".join(sorted(invalid)))
    return groups


def _selected(ctx, groups):
    for check_id, (group, function) in CHECKS.items():
        if group not in groups:
            continue
        if ctx.offline and check_id not in OFFLINE_CHECKS:
            continue
        yield check_id, function


def _run(ctx, groups):
    results = []
    for check_id, function in _selected(ctx, groups):
        try:
            results.append(function(ctx))
        except (AwsReadError, AwsUnavailable, ReadOnlyViolation, OSError,
                ValueError, KeyError, TypeError) as error:
            results.append(finding(
                check_id, "INCONCLUSIVE",
                "The check could not complete.",
                {"inspected": 0, "error": "%s: %s" %
                 (type(error).__name__, error)},
                remediation="Resolve the reported read error and run the check again.",
            ))
    return flatten(results)


def _metadata(ctx, groups):
    return {
        "kit": str(ctx.kit),
        "gateway_ref": ctx.gateway_ref,
        "offline": ctx.offline,
        "groups": sorted(groups),
        "target_vms": ctx.target_vms,
        "environment_loaded": bool(ctx.env),
    }


def main(argv=None):
    parser = _parser()
    try:
        args = parser.parse_args(argv)
        ctx = ValidationContext(args)
        groups = _groups(args.group)
        rows = _run(ctx, groups)
        document = report_document(rows, _metadata(ctx, groups))
        Path(args.report).write_text(
            json.dumps(document, indent=2, sort_keys=True) + "\n")
    except (ContextError, OSError, ValueError) as error:
        parser.error(str(error))
    for row in rows:
        print("%-3s %-12s %s" % (row.id, row.verdict, row.summary))
    print("report: %s" % args.report)
    return exit_code(rows)


if __name__ == "__main__":
    sys.exit(main())
