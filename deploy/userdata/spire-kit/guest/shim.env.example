# spire-kit header shim 配置 —— 复制成 shim.env 才会启动(unit 上有 ConditionPathExists)。
# 只有这一行是必填:真网关地址。OpenClaw 侧把"网关地址"配置值指到 127.0.0.1:18888 即可,
# 应用代码零改动。
SPIRE_SHIM_UPSTREAM=https://gateway.example.internal:443

# 可选
#SPIRE_SHIM_LISTEN=127.0.0.1:18888
#SPIRE_SHIM_HEADER=X-SPIFFE-JWT-SVID
#SPIRE_SHIM_HEADER_PREFIX=          # 网关要 "Bearer <jwt>" 就填 "Bearer "
#SPIRE_SHIM_AUDIENCE=bgw
#SPIRE_SHIM_ON_MISSING=forward      # forward(默认,不制造可用性悬崖)| reject(fail-closed)
#SPIRE_SHIM_REFRESH_SKEW=60
#SPIRE_SHIM_UPSTREAM_CA=/etc/spire-kit/upstream-ca.crt   # 私有 CA 的正确做法
