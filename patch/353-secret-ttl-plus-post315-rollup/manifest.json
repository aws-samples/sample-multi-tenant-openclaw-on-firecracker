  "fixes": [
    {
      "id": "#353",
      "summary": "remove tenant-secrets DDB TTL; ciphertext persists for tenant life so rebuild/recover reads back the original token",
      "paths": [
        "deploy/stacks/storage.py",
        "deploy/lambda/api/services/tenant_service.py"
      ],
      "applies_when": "always (tenant-secrets table exists)",
      "params_changed": [
        {
          "name": "openclaw-tenant-secrets DDB TTL",
          "layer": "D-cdk",
          "old_default": "TTL enabled (was 15-min then 30-day; expires_at attribute swept rows)",
          "new_default": "TTL disabled (ciphertext retained for the tenant lifetime)",
          "runtime_impact": "must disable TTL on the LIVE table via update-time-to-live (a template edit alone won't disable an already-enabled TTL); Lambda side stops writing expires_at + drops soft-expiry checks + delete_tenant no longer removes the row; recover/rebuild months later reads back the original token instead of an openssl fallback that mismatches; RETAIN — never re-enable (would sweep retained ciphertext = data loss)"
        }
      ],
      "verification_ids": [
        "v-353-ttl-disabled",
        "v-353-token-consistency"
      ]
    },
    {
      "id": "#331",
      "summary": "per-host cold-start launch concurrency gate (flock slots) so a burst recover doesn't fire hundreds of launch-vm and crush the host",
      "paths": [
        "deploy/userdata/launch-vm.sh",
        "deploy/lambda/api/services/dispatch_service.py",
        "deploy/lib/dispatch_infra.py",
        "config.yml.example",
        "deploy/userdata/init-host.sh"
      ],
      "applies_when": "always (all hosts launch VMs)",
      "params_changed": [
        {
          "name": "host_launch_slots / OC_HOST_LAUNCH_SLOTS / DISPATCH_HOST_LAUNCH_CONCURRENCY",
          "layer": "B-s3",
          "old_default": "no gate (unbounded concurrent launch-vm; a batch recover crushes the host)",
          "new_default": "30 (single source; injected to host as OC_HOST_LAUNCH_SLOTS and to Lambda as DISPATCH_HOST_LAUNCH_CONCURRENCY)",
          "runtime_impact": "host launch-vm queues via flock advisory slots (rate-limit, never drops a tenant); Lambda uses it as the SSM-timeout formula denominator ceil(batch/slots)*per_vm+120; future hosts get it via LT env re-bake; too small slows cold start, too large loses the protection"
        }
      ],
      "verification_ids": [
        "v-331-burst-no-crush"
      ]
    },
    {
      "id": "#323",
      "summary": "host-agent.service KillMode=process so restarting host-agent doesn't cgroup-kill every tenant firecracker on the host",
      "paths": [
        "deploy/userdata/host-agent.service"
      ],
      "applies_when": "always (every host runs host-agent)",
      "params_changed": [
        {
          "name": "host-agent.service KillMode",
          "layer": "A-lt",
          "old_default": "control-group (systemd default — restart SIGTERMs the whole cgroup, killing every tenant VM; #323 real-run killed 30 VMs)",
          "new_default": "process (only the main host-agent.py is signalled; restart kept 67/68 VMs alive)",
          "runtime_impact": "running hosts get a systemd drop-in + daemon-reload (do NOT restart host-agent during apply — this restart would still cgroup-kill); future ASG hosts get it via LT re-bake (CDK injects host-agent.service into the LT UserData, ha_edge.py:276 — NOT a golden-image bake); real-run gap: a new host before LT re-bake still boots control-group, so drop-in each new host until the new LT version is live"
        }
      ],
      "verification_ids": [
        "v-323-killmode-survives"
      ]
    },
    {
      "id": "#330",
      "summary": "dispatch capacity ledger gains a memory dimension (CAS on vcpu+mem) to stop oversell/OOM",
      "paths": [
        "deploy/lambda/api/services/dispatch_service.py",
        "deploy/lambda/api/core/dispatch/binpack.py",
        "deploy/lambda/api/core/dispatch/__init__.py",
        "deploy/lambda/api/core/clients.py",
        "deploy/lambda/api/services/dispatch_poller.py",
        "deploy/lambda/api/core/scheduling.py"
      ],
      "applies_when": "dispatch.mode==ddb",
      "params_changed": [
        {
          "name": "MEM_OVERCOMMIT_RATIO / mem-dimension CAS gate",
          "layer": "C-lambda",
          "old_default": "no mem gate (capacity CAS on vcpu only; a mem-heavy tenant could OOM the host)",
          "new_default": "mem CAS gate on total_mem_mb*MEM_OVERCOMMIT_RATIO; a host missing total_mem_mb falls back to allocatable_mem=0 sentinel = vcpu-only gate (never wrongly rejects a whole host on a missing field)",
          "runtime_impact": "new dispatch invocations only; running tenants untouched; a host DDB item without total_mem_mb keeps the old vcpu-only behavior until it re-registers with the field"
        }
      ],
      "verification_ids": [
        "v-330-no-oversell"
      ]
    },
    {
      "id": "#340",
      "summary": "dispatch soft-gate on host /data free disk so a full-disk host isn't handed new tenants",
      "paths": [
        "deploy/lambda/api/services/dispatch_service.py",
        "deploy/lib/dispatch_infra.py"
      ],
      "applies_when": "dispatch.mode==ddb",
      "params_changed": [
        {
          "name": "host /data free-disk soft gate",
          "layer": "C-lambda",
          "old_default": "no disk dimension (a full /data host still got new tenants -> mkdir No space -> converge requires_intervention)",
          "new_default": "soft-gate on reported avail_disk_mb; a host without the field is not rejected (soft, fail-open)",
          "runtime_impact": "new dispatch only; soft/fail-open so a missing metric never blocks placement, just deprioritizes a full host"
        }
      ],
      "verification_ids": [
        "v-340-disk-gate"
      ]
    },
    {
      "id": "#345",
      "summary": "guest log forwarding over vsock: guest tails logs -> local vsock (zero-credential) -> host reader -> Fluent Bit",
      "paths": [
        "deploy/userdata/oc-guest-log-forwarder.py",
        "deploy/userdata/oc-guest-log-reader.py",
        "deploy/userdata/launch-vm.sh",
        "deploy/userdata/init-host.sh",
        "build-rootfs.sh",
        "deploy/edge/fluent-bit/host/extract_tenant_id.lua",
        "deploy/edge/fluent-bit/host/fluent-bit.conf",
        "deploy/edge/fluent-bit/host/parsers.conf"
      ],
      "applies_when": "logging.enabled==true",
      "params_changed": [
        {
          "name": "OC_GUEST_LOG_ENABLED (guest-log vsock collection)",
          "layer": "B-s3",
          "old_default": "no guest-log collection",
          "new_default": "enabled by default (OC_GUEST_LOG_ENABLED=true); launch-vm PUTs the vsock before InstanceStart",
          "runtime_impact": "TWO-PART. Host side (reader oc-guest-log-reader.py + launch-vm vsock PUT + init-host reader unit) = B-s3/A-lt, HOT-APPLYABLE, apply first — safe because a guest without the forwarder just yields no logs (reader listens, forwarder connect-fail drops lines, never blocks the tenant). Guest side (oc-guest-log-forwarder.py + build-rootfs bake) lives in the read-only golden rootfs layer (not the per-VM data disk); to reach running tenants: bake a NEW rootfs with the forwarder, upload to S3, host pull-image swaps openclaw-rootfs.ext4, then rebuild existing tenants (swaps the rootfs layer, PRESERVES the data disk). The new rootfs is NOT baked yet — APPLY carries 'bake+upload rootfs' as an explicit prerequisite step before the guest side takes effect."
        }
      ],
      "verification_ids": [
        "v-345-host-reader",
        "v-345-guest-forwarder"
      ]
    },
    {
      "id": "#321",
      "summary": "host disk leak: delete-tenant now removes the VM dir (overlay/data disks) so orphans don't fill /data",
      "paths": [
        "deploy/userdata/launch-vm.sh",
        "deploy/userdata/host-agent.py"
      ],
      "applies_when": "always",
      "params_changed": [],
      "verification_ids": [
        "v-321-no-orphan-dir"
      ]
    },
    {
      "id": "#336",
      "summary": "copy-file-from-s3 contract: owner ubuntu:ubuntu + mode 755 + atomic write + status return",
      "paths": [
        "deploy/lambda/api/handler.py",
        "deploy/lambda/api/services/host_service.py"
      ],
      "applies_when": "always",
      "params_changed": [],
      "verification_ids": [
        "v-336-copyfile-contract"
      ]
    },
    {
      "id": "#343",
      "summary": "pull-image writes host.rootfs_version after success so scaler/rebuild don't misjudge/mis-report drift",
      "paths": [
        "deploy/lambda/api/services/host_service.py"
      ],
      "applies_when": "always",
      "params_changed": [],
      "verification_ids": [
        "v-343-rootfs-version-synced"
      ]
    },
    {
      "id": "#338",
      "summary": "pull-image progress streamed to Fluent Bit -> OpenSearch",
      "paths": [
        "deploy/lambda/api/services/host_service.py",
        "deploy/edge/fluent-bit/host/fluent-bit.conf",
        "deploy/edge/fluent-bit/host/parsers.conf",
        "deploy/edge/fluent-bit/host/extract_tenant_id.lua"
      ],
      "applies_when": "logging.enabled==true",
      "params_changed": [],
      "verification_ids": [
        "v-338-pull-progress-visible"
      ]
    }
  ],
