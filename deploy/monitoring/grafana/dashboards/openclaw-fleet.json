{
  "annotations": { "list": [] },
  "editable": true,
  "description": "OpenClaw-on-Firecracker microVM fleet runtime metrics. All panels use the 7 gauges host-agent.py actually exports on :8899/metrics (openclaw_vm_*). 'VM count' / 'healthy nodes' are derived by count()/sum() over the per-tenant series since host-agent emits no standalone count metric. Per-host grouping uses the 'instance' label injected by Prometheus ec2_sd relabel (host-agent itself emits only a 'tenant' label).",
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "title": "VM 总数 (全 fleet)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "count(openclaw_vm_health{instance=~\"$instance\"})",
          "legendFormat": "VMs",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "健康 VM 数 (vm_health=1)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(openclaw_vm_health{instance=~\"$instance\"})",
          "legendFormat": "healthy",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "不健康 VM 数 (vm_health=0)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "count(openclaw_vm_health{instance=~\"$instance\"}) - sum(openclaw_vm_health{instance=~\"$instance\"})",
          "legendFormat": "unhealthy",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "fleet 内存占用合计 (MB)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "decmbytes",
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(openclaw_vm_memory_used_mb{instance=~\"$instance\"})",
          "legendFormat": "used MB",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "每台 host 的 VM 数 (count by instance)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "stacking": { "mode": "none" }
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": ["lastNotNull"]
        },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "expr": "count(openclaw_vm_health{instance=~\"$instance\"}) by (instance)",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "每台 host 健康 VM 数 (sum vm_health by instance)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "fillOpacity": 10 },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": ["lastNotNull"]
        },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "expr": "sum(openclaw_vm_health{instance=~\"$instance\"}) by (instance)",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "每台 host 内存占用合计 (sum memory_used_mb by instance)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15,
            "stacking": { "mode": "normal" }
          },
          "unit": "decmbytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": ["lastNotNull", "max"]
        },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "expr": "sum(openclaw_vm_memory_used_mb{instance=~\"$instance\"}) by (instance)",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "balloon 持有量合计 (sum memory_balloon_mib by instance)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "fillOpacity": 10 },
          "unit": "mbytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": ["lastNotNull"]
        },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "expr": "sum(openclaw_vm_memory_balloon_mib{instance=~\"$instance\"}) by (instance)",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "title": "Top 20 VM CPU 占用 % (per-tenant cpu_pct)",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "fillOpacity": 5 },
          "unit": "percent",
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "expr": "topk(20, openclaw_vm_cpu_pct{instance=~\"$instance\"})",
          "legendFormat": "{{instance}} / {{tenant}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "title": "Top 20 VM 数据盘占用 % (per-tenant disk_used_pct)",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "fillOpacity": 5 },
          "unit": "percent",
          "max": 100,
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 80 },
              { "color": "red", "value": 90 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "expr": "topk(20, openclaw_vm_disk_used_pct{instance=~\"$instance\"})",
          "legendFormat": "{{instance}} / {{tenant}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "title": "per-VM 明细 (内存/盘/CPU/health by tenant)",
      "type": "table",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 29 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": { "showHeader": true },
      "targets": [
        {
          "expr": "openclaw_vm_memory_used_mb{instance=~\"$instance\"}",
          "legendFormat": "",
          "refId": "MEM",
          "format": "table",
          "instant": true
        },
        {
          "expr": "openclaw_vm_disk_used_pct{instance=~\"$instance\"}",
          "legendFormat": "",
          "refId": "DISK",
          "format": "table",
          "instant": true
        },
        {
          "expr": "openclaw_vm_cpu_pct{instance=~\"$instance\"}",
          "legendFormat": "",
          "refId": "CPU",
          "format": "table",
          "instant": true
        },
        {
          "expr": "openclaw_vm_health{instance=~\"$instance\"}",
          "legendFormat": "",
          "refId": "HEALTH",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        { "id": "merge", "options": {} },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "az": true,
              "host_name": true
            },
            "renameByName": {
              "Value #MEM": "mem_used_mb",
              "Value #DISK": "disk_used_pct",
              "Value #CPU": "cpu_pct",
              "Value #HEALTH": "health"
            }
          }
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["openclaw", "firecracker", "microvm"],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "Prometheus", "value": "Prometheus" },
        "hide": 0
      },
      {
        "name": "instance",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "query": "label_values(openclaw_vm_health, instance)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": { "text": "All", "value": "$__all" },
        "refresh": 2,
        "label": "Host (instance)"
      }
    ]
  },
  "time": { "from": "now-3h", "to": "now" },
  "timepicker": {},
  "timezone": "",
  "title": "OpenClaw microVM Fleet (host-agent)",
  "uid": "openclaw-fleet",
  "version": 1
}
