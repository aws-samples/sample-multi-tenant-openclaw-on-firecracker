# 部署配置 - 示例
# 复制为 config.yml 后按需修改

# ========== 宿主机 (EC2) ==========
host:
  instance_type: m8i.xlarge        # 支持嵌套虚拟化: c8i/m8i/r8i 系列
  root_volume_gb: 20
  data_volume_gb: 200              # 建议每个 VM 预留 ~16GB
  keep_data_volume:  true          # 实例删除后是否保留EBS卷
  reserved_vcpu: 1
  reserved_mem_mb: 2048
  cpu_overcommit_ratio: 2.0        # 1.0=不超配, 2.0=可分配 2 倍 vCPU
  mem_overcommit_ratio: 1.5        # 1.0=不超配, 1.5=可分配 1.5 倍内存

# ========== Balloon 内存回收 (配合 mem_overcommit) ==========
balloon:
  enabled: true                    # 启用 balloon 设备实现真正的内存超配
  max_inflate_ratio: 0.4           # 最多回收 VM 声明内存的 40%
  min_guest_available_mb: 512      # guest 至少保留 512MB 可用内存
  stats_polling_interval_s: 5      # balloon 统计采集间隔
  deflate_on_oom: true             # guest OOM 时自动归还内存
  free_page_reporting: true        # guest 主动报告空闲页

# ========== microVM ==========
vm:
  default_vcpu: 2
  default_mem_mb: 4096
  rootfs_overlay_mb: 8192          # 每个 VM 可写层上限 (sparse, 不预占空间)
  data_disk_mb: 8192               # 每个 VM 数据盘 /home/agent 上限 (sparse)
  gateway_port_base: 18789
  subnet_prefix: "172.16"

# ========== S3 ==========
s3:
  rootfs_prefix: "deployment/rootfs"
  backup_prefix: "backups"
  backup_retention_days: 7
  backup_cron: "cron(0 19 * * ? *)"  # UTC 19:00 = 北京时间 03:00

# ========== Auto Scaling ==========
asg:
  min_capacity: 1
  max_capacity: 5
  lifecycle_hook_timeout: 600
  use_spot: false

# ========== Multi-AZ HA (issue #8) ==========
# 跨 AZ 部署 ASG + ALB 实现高可用. 默认关闭 (single AZ 减少跨 AZ 数据传输费用).
# 启用后 az_count 控制最多使用几个 AZ; 实际数量受 region 可用 AZ 数限制.
multi_az:
  enabled: false
  az_count: 2

scaler:
  interval_minutes: 3
  idle_timeout_minutes: 10

# ========== 健康检查 ==========
health_check:
  interval_minutes: 5
  max_failures: 3
  app_port: 18789

# ========== AgentCore (可选) ==========
agentcore:
  enabled: false                   # 开启后所有 VM 自动连接 AgentCore
  # gateway:
  #   enabled: true
  # memory:
  #   enabled: true
  #   strategies: [semantic, user_preference]
  #   expiration_days: 90
  # code_interpreter:
  #   enabled: true
  # browser:
  #   enabled: true

# ========== Console 认证 (可选) ==========
console_auth:
  enabled: false                   # 开启后 Console 需要 Cognito 登录
  self_sign_up: false              # 允许用户自注册
  # user_pool_id: ""              # 已有 User Pool ID，留空自动创建
  # user_pool_client_id: ""       # 已有 App Client ID

# ========== CloudFront 自定义域名 (可选) ==========
# 可通过 ./setup.sh <region> <profile> --domain <domain> --cert <acm-arn> 一键配置
cloudfront:
  custom_domain: ""                # 例: claw.aws.xin，留空则使用默认 *.cloudfront.net
  acm_cert_arn: ""                 # us-east-1 ACM 证书 ARN (CloudFront 必须 us-east-1)
